{
  "hadith": [
    {"text": "«إنما الأعمال بالنيات، وإنما لكل امرئ ما نوى»", "source": "متفق عليه"},
    {"text": "«الكلمة الطيبة صدقة»", "source": "متفق عليه"},
    {"text": "«من كان يؤمن بالله واليوم الآخر فليقل خيرًا أو ليصمت»", "source": "متفق عليه"},
    {"text": "«لا يؤمن أحدكم حتى يحب لأخيه ما يحب لنفسه»", "source": "متفق عليه"},
    {"text": "«خيركم من تعلم القرآن وعلمه»", "source": "رواه البخاري"},
    {"text": "«الطهور شطر الإيمان»", "source": "رواه مسلم"},
    {"text": "«المسلم من سلم المسلمون من لسانه ويده»", "source": "متفق عليه"},
    {"text": "«أحب الأعمال إلى الله أدومها وإن قل»", "source": "متفق عليه"},
    {"text": "«من دل على خير فله مثل أجر فاعله»", "source": "رواه مسلم"},
    {"text": "«لا تحقرن من المعروف شيئًا ولو أن تلقى أخاك بوجه طلق»", "source": "رواه مسلم"},
    {"text": "«يسروا ولا تعسروا، وبشروا ولا تنفروا»", "source": "متفق عليه"},
    {"text": "«الدين النصيحة»", "source": "رواه مسلم"}
  ],
  "dua": [
    {"text": "«اللهم إني أسألك علمًا نافعًا، ورزقًا طيبًا، وعملًا متقبلًا»", "source": "رواه ابن ماجه"},
    {"text": "«ربنا آتنا في الدنيا حسنة، وفي الآخرة حسنة، وقنا عذاب النار»", "source": "متفق عليه"},
    {"text": "«اللهم إني أسألك الهدى والتقى والعفاف والغنى»", "source": "رواه مسلم"},
    {"text": "«يا مقلب القلوب ثبت قلبي على دينك»", "source": "رواه الترمذي"},
    {"text": "«اللهم أعني على ذكرك وشكرك وحسن عبادتك»", "source": "رواه أبو داود والنسائي"},
    {"text": "«اللهم إني أعوذ بك من الهم والحزن، والعجز والكسل، والجبن والبخل، وضلع الدين وغلبة الرجال»", "source": "رواه البخاري"}
  ],
  "ayah": [
    {"text": "﴿أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ﴾", "source": "سورة الرعد · 28"},
    {"text": "﴿فَاذْكُرُونِي أَذْكُرْكُمْ وَاشْكُرُوا لِي وَلَا تَكْفُرُونِ﴾", "source": "سورة البقرة · 152"},
    {"text": "﴿إِنَّ مَعَ الْعُسْرِ يُسْرًا﴾", "source": "سورة الشرح · 6"},
    {"text": "﴿وَقُل رَّبِّ زِدْنِي عِلْمًا﴾", "source": "سورة طه · 114"},
    {"text": "﴿وَمَن يَتَوَكَّلْ عَلَى اللَّهِ فَهُوَ حَسْبُهُ﴾", "source": "سورة الطلاق · 3"},
    {"text": "﴿لَا يُكَلِّفُ اللَّهُ نَفْسًا إِلَّا وُسْعَهَا﴾", "source": "سورة البقرة · 286"},
    {"text": "﴿وَاصْبِرْ فَإِنَّ اللَّهَ لَا يُضِيعُ أَجْرَ الْمُحْسِنِينَ﴾", "source": "سورة هود · 115"},
    {"text": "﴿وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ﴾", "source": "سورة البقرة · 186"},
    {"text": "﴿إِنَّ اللَّهَ مَعَ الصَّابِرِينَ﴾", "source": "سورة البقرة · 153"},
    {"text": "﴿وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ﴾", "source": "سورة الضحى · 5"}
  ]
}
