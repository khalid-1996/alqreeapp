<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/adhkar_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/adhkar_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="أذكار الصباح"
                android:textColor="#3BA7FF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/adhkar_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A9B3D6"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/adhkar_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:gravity="center"
            android:text="افتح الأذكار"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/adhkar_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#A9B3D6"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/adhkar_count_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/adhkar_left"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#DDE3F7"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adhkar_count"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="عُدّ +١"
            android:textColor="#000A3A"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
